{
  "name": "shengciben",
  "version": "2.2.2",
  "description": "DeepSeek AI 生词本",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mts",
    "eval:phrases:blind": "node --no-warnings --experimental-strip-types scripts/evaluate-local-phrases.mts",
    "test:roots:random": "node --no-warnings --experimental-strip-types tests/root-indexer-random-audit.mts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "prepare:local-ai": "node scripts/prepare-local-ai.mjs",
    "build:win": "npm run prepare:local-ai && npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.27.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.local.shengciben",
    "productName": "生词本",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "shengciben-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kiasma1",
        "repo": "shengciben"
      }
    ]
  }
}
